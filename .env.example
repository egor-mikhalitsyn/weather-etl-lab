# Ключ и адрес OpenWeatherMap. Настоящий ключ записывайте только в .env.
WEATHER_API_KEY=put_your_openweathermap_key_here
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
# ipinfo работает без токена; для 2ip укажите URL и GEO_API_KEY.
GEO_API_KEY=
GEO_API_URL=https://ipinfo.io/json
GEO_API_FALLBACK_CITY=Kirov
# Координаты относятся к резервному городу; меняйте все три значения вместе.
GEO_API_FALLBACK_LAT=58.6035
GEO_API_FALLBACK_LON=49.6679
# Относительный путь к SQLite разрешается от корня проекта.
DB_URL=sqlite:///weather_lab.db
DB_USER=unused_for_sqlite
DB_PASSWORD=unused_for_sqlite
ENVIRONMENT=development
# Основной отчёт текущего города на сегодня и три следующих дня.
OUTPUT_FILE=weather_report.md
# Дополнительные отчёты с историей всех городов из БД.
OUTPUT_DIR=data_weather
# Консоль и log/app.log, ротация 10 МБ с тремя резервными файлами.
LOG_LEVEL=INFO
LOG_DIR=log
